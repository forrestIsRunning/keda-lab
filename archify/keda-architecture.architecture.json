    "views": [
      {
        "id": "zero-to-one",
        "label": "0 到 1",
        "focus": ["redis", "operator", "deploy"],
        "note": "operator 轮询 LLEN。队列长度大于 0 时，自己把 Deployment 的 scale 从 0 写成 1。"
      },
      {
        "id": "one-to-n",
        "label": "1 到 N",
        "focus": ["hpa", "apiserver", "metrics", "operator", "redis"],
        "note": "HPA 经 apiserver 问外部指标。metrics-apiserver 用 gRPC 问回 leader 上的同一个 scaler。"
      },
      {
        "id": "consume",
        "label": "消费者取订单",
        "focus": ["worker", "redis"],
        "note": "Pod 自己 BLPOP。KEDA 不在这条连接上，也不读订单正文。"
      }
    ]
